get_target_property(THL_WEBVIEW_SOURCE_DIR flutter_inappwebview_windows_plugin SOURCE_DIR)
set(THL_WEBVIEW_MANAGER "${THL_WEBVIEW_SOURCE_DIR}/in_app_webview/in_app_webview_manager.cpp")
file(READ "${THL_WEBVIEW_MANAGER}" THL_WEBVIEW_CONTENT)
string(REPLACE "\r\n" "\n" THL_WEBVIEW_CONTENT "${THL_WEBVIEW_CONTENT}")
string(REGEX REPLACE "#include \"([^\"]+)\""
  "#include \"${THL_WEBVIEW_SOURCE_DIR}/in_app_webview/\\1\""
  THL_WEBVIEW_CONTENT "${THL_WEBVIEW_CONTENT}")
set(THL_WEBVIEW_DESTRUCTOR_END "    plugin = nullptr;\n  }\n}")
string(FIND "${THL_WEBVIEW_CONTENT}" "${THL_WEBVIEW_DESTRUCTOR_END}" THL_WEBVIEW_DESTRUCTOR_INDEX)
if(THL_WEBVIEW_DESTRUCTOR_INDEX EQUAL -1)
  message(FATAL_ERROR "The WebView shutdown patch must be reviewed for this plugin version.")
endif()
string(REPLACE "${THL_WEBVIEW_DESTRUCTOR_END}"
  "    plugin = nullptr;\n#include \"${CMAKE_CURRENT_LIST_DIR}/webview_shutdown.inc\"\n  }\n}"
  THL_WEBVIEW_CONTENT "${THL_WEBVIEW_CONTENT}")
set(THL_WEBVIEW_PATCHED "${CMAKE_CURRENT_BINARY_DIR}/webview/in_app_webview_manager.cpp")
set(THL_WEBVIEW_PREVIOUS "")
if(EXISTS "${THL_WEBVIEW_PATCHED}")
  file(READ "${THL_WEBVIEW_PATCHED}" THL_WEBVIEW_PREVIOUS)
endif()
if(NOT THL_WEBVIEW_CONTENT STREQUAL THL_WEBVIEW_PREVIOUS)
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/webview")
  file(WRITE "${THL_WEBVIEW_PATCHED}" "${THL_WEBVIEW_CONTENT}")
endif()
get_target_property(THL_WEBVIEW_SOURCES flutter_inappwebview_windows_plugin SOURCES)
set(THL_WEBVIEW_PATCHED_SOURCES)
foreach(THL_WEBVIEW_SOURCE IN LISTS THL_WEBVIEW_SOURCES)
  if(THL_WEBVIEW_SOURCE STREQUAL "in_app_webview/in_app_webview_manager.cpp" OR
      THL_WEBVIEW_SOURCE STREQUAL THL_WEBVIEW_MANAGER)
    list(APPEND THL_WEBVIEW_PATCHED_SOURCES "${THL_WEBVIEW_PATCHED}")
  elseif(IS_ABSOLUTE "${THL_WEBVIEW_SOURCE}" OR THL_WEBVIEW_SOURCE MATCHES "^\\$<")
    list(APPEND THL_WEBVIEW_PATCHED_SOURCES "${THL_WEBVIEW_SOURCE}")
  else()
    list(APPEND THL_WEBVIEW_PATCHED_SOURCES "${THL_WEBVIEW_SOURCE_DIR}/${THL_WEBVIEW_SOURCE}")
  endif()
endforeach()
set_property(TARGET flutter_inappwebview_windows_plugin PROPERTY SOURCES "${THL_WEBVIEW_PATCHED_SOURCES}")
target_link_libraries(flutter_inappwebview_windows_plugin PRIVATE runtimeobject)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${THL_WEBVIEW_MANAGER}")
