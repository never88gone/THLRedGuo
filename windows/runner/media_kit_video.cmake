get_target_property(THL_VIDEO_SOURCE_DIR media_kit_video_plugin SOURCE_DIR)
set(THL_VIDEO_PATCH_DIR "${CMAKE_CURRENT_BINARY_DIR}/media_kit_video")

function(thl_video_replace variable before after)
  string(FIND "${${variable}}" "${before}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "The media_kit_video patch must be reviewed for this plugin version: ${before}")
  endif()
  string(REPLACE "${before}" "${after}" content "${${variable}}")
  set(${variable} "${content}" PARENT_SCOPE)
endfunction()

function(thl_video_region variable first last replacement)
  set(content "${${variable}}")
  string(FIND "${content}" "${first}" begin)
  if(begin EQUAL -1)
    message(FATAL_ERROR "The media_kit_video region must be reviewed: ${first}")
  endif()
  string(SUBSTRING "${content}" 0 ${begin} prefix)
  if(last STREQUAL "EOF")
    set(suffix "")
  else()
    string(SUBSTRING "${content}" ${begin} -1 tail)
    string(FIND "${tail}" "${last}" finish)
    if(finish EQUAL -1)
      message(FATAL_ERROR "The media_kit_video region end must be reviewed: ${last}")
    endif()
    string(SUBSTRING "${tail}" ${finish} -1 suffix)
  endif()
  set(${variable} "${prefix}${replacement}${suffix}" PARENT_SCOPE)
endfunction()

file(GLOB THL_VIDEO_FILES CONFIGURE_DEPENDS "${THL_VIDEO_SOURCE_DIR}/*.h" "${THL_VIDEO_SOURCE_DIR}/*.cc")
file(MAKE_DIRECTORY "${THL_VIDEO_PATCH_DIR}")
foreach(source IN LISTS THL_VIDEO_FILES)
  get_filename_component(name "${source}" NAME)
  file(READ "${source}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  if(name STREQUAL "video_output.h")
    thl_video_replace(content "#include <flutter/plugin_registrar_windows.h>" "#include <atomic>\n#include <condition_variable>\n#include <flutter/plugin_registrar_windows.h>")
    thl_video_replace(content "  void NotifyRender();" "  void RetireTexture(int64_t id);\n  void NotifyRender();")
    thl_video_replace(content "  int64_t texture_id_ = 0;" "  std::atomic<int64_t> texture_id_{0};")
    thl_video_replace(content "  bool destroyed_ = false;" "  std::atomic<bool> destroyed_{false};\n  std::mutex retirement_mutex_;\n  std::condition_variable retirement_condition_;\n  size_t pending_retirements_ = 0;")
  elseif(name STREQUAL "video_output_manager.h")
    thl_video_replace(content "  void Dispose(int64_t handle);" "  void Dispose(int64_t handle, std::function<void()> completed);")
    thl_video_replace(content "  std::mutex mutex_ = std::mutex();" "  std::mutex mutex_ = std::mutex();\n  std::unique_ptr<ThreadPool> operations_ = std::make_unique<ThreadPool>(1);")
  elseif(name STREQUAL "video_output_manager.cc")
    thl_video_region(content "void VideoOutputManager::Create(" "EOF" "#include \"${CMAKE_CURRENT_LIST_DIR}/media_kit_manager.inc\"\n")
  elseif(name STREQUAL "media_kit_video_plugin.cc")
    thl_video_replace(content "MediaKitVideoPlugin::~MediaKitVideoPlugin() {" "MediaKitVideoPlugin::~MediaKitVideoPlugin() {\n  video_output_manager_.reset();")
    thl_video_replace(content "    video_output_manager_->Dispose(handle_value);\n    result->Success(flutter::EncodableValue(std::monostate{}));"
      "    auto completion = std::shared_ptr<flutter::MethodResult<flutter::EncodableValue>>(std::move(result));\n    video_output_manager_->Dispose(handle_value, [this, completion]() {\n      RunOnMainThread([completion]() {\n        completion->Success(flutter::EncodableValue(std::monostate{}));\n      });\n    });")
  elseif(name STREQUAL "video_output.cc")
    thl_video_replace(content "    mpv_set_option_string(handle_, \"video-sync\", \"audio\");" "    int advanced_control = 1;\n    mpv_set_option_string(handle_, \"video-sync\", \"audio\");")
    thl_video_replace(content "{MPV_RENDER_PARAM_OPENGL_INIT_PARAMS, &gl_init_params}," "{MPV_RENDER_PARAM_OPENGL_INIT_PARAMS, &gl_init_params},\n            {MPV_RENDER_PARAM_ADVANCED_CONTROL, &advanced_control},")
    thl_video_replace(content "{MPV_RENDER_PARAM_API_TYPE, MPV_RENDER_API_TYPE_SW}," "{MPV_RENDER_PARAM_API_TYPE, MPV_RENDER_API_TYPE_SW},\n          {MPV_RENDER_PARAM_ADVANCED_CONTROL, &advanced_control},")
    thl_video_region(content "VideoOutput::~VideoOutput() {" "void VideoOutput::NotifyRender()" "#include \"${CMAKE_CURRENT_LIST_DIR}/media_kit_output_dispose.inc\"\n\n")
    thl_video_replace(content "void VideoOutput::Render() {" "void VideoOutput::Render() {\n  if (destroyed_) return;")
    thl_video_replace(content "      surface_manager_->Draw([&]() {" "      surface_manager_->Draw([&]() {\n        mpv_render_context_update(render_context_);")
    thl_video_replace(content "    if (pixel_buffer_ != nullptr) {\n      int32_t size[]{" "    if (pixel_buffer_ != nullptr) {\n      mpv_render_context_update(render_context_);\n      int32_t size[]{")
    thl_video_replace(content "void VideoOutput::CheckAndResize() {" "void VideoOutput::CheckAndResize() {\n  if (destroyed_) return;")
    thl_video_region(content "void VideoOutput::SetSize(" "void VideoOutput::CheckAndResize()" "#include \"${CMAKE_CURRENT_LIST_DIR}/media_kit_output_size.inc\"\n\n")
    thl_video_region(content "  // Unregister previously registered texture & delete underlying objects." "\n  // H/W\n  if (surface_manager_ != nullptr)" "  RetireTexture(texture_id_.exchange(0));\n")
    thl_video_region(content "    auto texture_variant =\n        std::make_unique<flutter::TextureVariant>(flutter::GpuSurfaceTexture(" "    // Register new texture." "#include \"${CMAKE_CURRENT_LIST_DIR}/media_kit_gpu_texture.inc\"\n")
    thl_video_region(content "    auto texture_variant = std::make_unique<flutter::TextureVariant>(\n        flutter::PixelBufferTexture(" "    // Register new texture." "#include \"${CMAKE_CURRENT_LIST_DIR}/media_kit_pixel_texture.inc\"\n")
    thl_video_replace(content "    // Notify public texture update callback.\n    texture_update_callback_(" "    published_id->store(texture_id_.load());\n    texture_update_callback_(")
    thl_video_region(content "int64_t VideoOutput::GetVideoWidth() {" "EOF" "int64_t VideoOutput::GetVideoWidth() { return width_.value_or(1); }\nint64_t VideoOutput::GetVideoHeight() { return height_.value_or(1); }\n")
    thl_video_replace(content "std::make_pair(texture_id_, " "std::make_pair(texture_id_.load(), ")
  elseif(name STREQUAL "angle_surface_manager.cc")
    thl_video_region(content "void ANGLESurfaceManager::SetSize(" "void ANGLESurfaceManager::Draw(" "void ANGLESurfaceManager::SetSize(int32_t width, int32_t height) {\n  if (width == width_ && height == height_) return;\n  ::WaitForSingleObject(mutex_, INFINITE);\n  struct Unlock { HANDLE value; ~Unlock() { ::ReleaseMutex(value); } } unlock{mutex_};\n  width_ = width;\n  height_ = height;\n  Create();\n}\n\n")
  endif()
  set(destination "${THL_VIDEO_PATCH_DIR}/${name}")
  set(previous "")
  if(EXISTS "${destination}")
    file(READ "${destination}" previous)
  endif()
  if(NOT content STREQUAL previous)
    file(WRITE "${destination}" "${content}")
  endif()
endforeach()

get_target_property(THL_VIDEO_SOURCES media_kit_video_plugin SOURCES)
set(THL_VIDEO_PATCHED_SOURCES)
foreach(source IN LISTS THL_VIDEO_SOURCES)
  get_filename_component(name "${source}" NAME)
  if(EXISTS "${THL_VIDEO_PATCH_DIR}/${name}")
    list(APPEND THL_VIDEO_PATCHED_SOURCES "${THL_VIDEO_PATCH_DIR}/${name}")
  elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
    list(APPEND THL_VIDEO_PATCHED_SOURCES "${source}")
  else()
    list(APPEND THL_VIDEO_PATCHED_SOURCES "${THL_VIDEO_SOURCE_DIR}/${source}")
  endif()
endforeach()
set_property(TARGET media_kit_video_plugin PROPERTY SOURCES "${THL_VIDEO_PATCHED_SOURCES}")
target_include_directories(media_kit_video_plugin BEFORE PRIVATE "${THL_VIDEO_PATCH_DIR}" "${THL_VIDEO_SOURCE_DIR}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${THL_VIDEO_FILES})
