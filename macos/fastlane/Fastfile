def find_project_root
  dir = File.dirname(File.expand_path(__FILE__))
  while dir != "/" && !File.exist?(File.join(dir, "pubspec.yaml"))
    dir = File.dirname(dir)
  end
  dir
end

PROJECT_ROOT = find_project_root
MACOS_DIR = File.join(PROJECT_ROOT, "macos")

# Custom methods
def get_version_from_pubspec
  pubspec_path = File.join(PROJECT_ROOT, "pubspec.yaml")
  return "1.0.0" unless File.exist?(pubspec_path)
  pubspec_content = File.read(pubspec_path)
  match = pubspec_content.match(/version:\s*(\d+\.\d+\.\d+)/)
  match ? match[1] : "1.0.0"
end

def get_build_number_from_pubspec
  Time.now.strftime("%y%j%H%M")
end

default_platform(:mac)

platform :mac do
  private_lane :authenticate_apple_store do
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && ENV["APP_STORE_CONNECT_API_KEY_KEY"]
      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true,
        in_house: false
      )
    end
  end

  desc "Build macOS release app or pkg using fastlane/thlredlook_macOS_dis.provisionprofile"
  lane :build_pkg do |options|
    authenticate_apple_store

    if is_ci
      # setup_ci
    end

    # Clean AppleDouble metadata files to avoid codesign failure
    system("find #{PROJECT_ROOT} -name '._*' -delete 2>/dev/null || true")
    system("find #{File.expand_path('~/.pub-cache')} -name '._*' -delete 2>/dev/null || true")

    ver = options.fetch(:version_number, get_version_from_pubspec)
    build_num = options.fetch(:build_number, get_build_number_from_pubspec)

    profile_path = File.join(PROJECT_ROOT, "fastlane/thlredlook_macOS_dis.provisionprofile")
    if File.exist?(profile_path)
      UI.message("Installing provisioning profile: #{profile_path}")
      install_provisioning_profile(path: profile_path)
    else
      UI.user_error!("macOS provisioning profile not found at #{profile_path}")
    end

    update_code_signing_settings(
      use_automatic_signing: false,
      path: File.join(MACOS_DIR, "Runner.xcodeproj"),
      team_id: "876385K952",
      profile_name: "thlredlook_macOS_dis",
      build_configurations: ["Release"]
    )

    sh("cd #{PROJECT_ROOT} && python3 scripts/build_native.py --platform darwin 2>/dev/null || true")
    sh("cd #{PROJECT_ROOT} && #{ENV['FVM_PREFIX'] || 'fvm '}flutter build macos --release --build-name=#{ver} --build-number=#{build_num}")

    output_dir = File.join(PROJECT_ROOT, "build/macos/pkg")
    FileUtils.mkdir_p(output_dir)

    gym(
      workspace: File.join(MACOS_DIR, "Runner.xcworkspace"),
      scheme: "Runner",
      export_method: "app-store",
      export_team_id: "876385K952",
      xcargs: "DEVELOPMENT_TEAM=876385K952",
      export_options: {
        method: "app-store",
        teamID: "876385K952",
        provisioningProfiles: {
          (ENV["APP_BUNDLE_ID"] || "com.never88gone.redlook") => "thlredlook_macOS_dis"
        },
        compileBitcode: false,
        uploadBitcode: false
      },
      output_directory: output_dir,
      output_name: "redlook-macos"
    )
  end

  desc "Release a new Mac build to Apple Store / TestFlight"
  lane :release_app_store do |options|
    authenticate_apple_store

    build_pkg(options)

    pkg_path = Actions.lane_context[SharedValues::PKG_OUTPUT_PATH] || File.join(PROJECT_ROOT, "build/macos/pkg/redlook-macos.pkg")
    if File.exist?(pkg_path.to_s)
      upload_to_testflight(
        skip_waiting_for_build_processing: true,
        app_platform: "osx",
        uses_non_exempt_encryption: false,
        pkg: pkg_path
      )
    else
      upload_to_testflight(
        skip_waiting_for_build_processing: true,
        app_platform: "osx",
        uses_non_exempt_encryption: false
      )
    end
  end
end
